print_countdown() {
    echo -ne "\r REINICIANDO EN : $1 seconds    "
}
countdown() {
    local seconds="$1"
    while [ "$seconds" -gt 0 ]; do
        print_countdown "$seconds"
        sleep 1
        seconds=$((seconds - 1))
    done
    echo -e "\rRESTART complete!         "
    sudo reboot
}
