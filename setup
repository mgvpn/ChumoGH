            wget --no-check-certificate -q -O "${SCPinstal}/${arqx}" "https://raw.githubusercontent.com/mgvpn/ChumoGH/main/core/${arqx}" 2>/dev/null || true
        fi
        verificar_arq "${arqx}"
    done
